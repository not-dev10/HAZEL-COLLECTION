{
  "name": "didi-backend",
  "version": "1.0.0",
  "description": "Didi Fashion E-commerce Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && node src/server.js",
    "dev": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && nodemon src/server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:products": "node scripts/test-products.mjs"
  },
  "keywords": [
    "api",
    "ecommerce",
    "fashion"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.1.11"
  }
}
