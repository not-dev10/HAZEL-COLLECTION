# Development - Explicitly set API URL (optional)
# If not set, frontend will:
# 1. Try to auto-detect backend port on localhost (5000, 5001, 5002, 3000, 3001, etc.)
# 2. Use relative path to /api for production (same domain)
# VITE_API_URL=http://localhost:5000

# Production when backend is on different domain
# If NOT set, frontend assumes backend is on same domain and uses relative path (/api)
# VITE_API_URL=https://api.didifashion.com

# For Render deployment or other external backends:
VITE_API_URL=https://hazel-collection.onrender.com
