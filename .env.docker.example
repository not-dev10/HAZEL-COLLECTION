# Docker environment file example
# Copy this to .env.docker and fill in the values for Docker deployment

# =======================
# Core Configuration
# =======================
NODE_ENV=production
PORT=5000

# =======================
# Database Configuration
# =======================
# Using MongoDB Atlas (recommended for cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0

# Or use local MongoDB in Docker (uncomment docker-compose.yml mongodb service)
# MONGODB_URI=mongodb://admin:password@mongodb:27017/didi_fashion?authSource=admin

# =======================
# CORS & Frontend Configuration
# =======================
# Set to your production domain
FRONTEND_URL=https://your-domain.com

# Or use localhost for local Docker testing
# FRONTEND_URL=http://localhost:8080

# =======================
# Backend Internal URL (for Docker networking)
# =======================
# Docker uses service name as hostname
BACKEND_URL=http://backend:5000
BACKEND_HOST=backend

# =======================
# Security & Secrets
# =======================
# 🔒 CRYPTO KEYS - Keep these secure and never commit!
JWT_SECRET=your-jwt-secret-key-min-32-characters-long-change-this
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-characters-long-change-this
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long-change-this
ADMIN_SECRET=your-admin-secret-min-32-characters-long-change-this
SESSION_SECRET=your-session-secret-min-32-characters-long-change-this

# =======================
# Cloudinary Configuration
# =======================
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =======================
# Email Configuration (Gmail with App Password)
# =======================
MAIL_SERVICE=gmail
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-16-chars
MAIL_FROM_NAME=HezalTheLabel

# =======================
# Admin Configuration
# =======================
ADMIN_EMAIL=hazellabel@gmail.com
ADMIN_PASSWORD=your-admin-password

# =======================
# Security & Rate Limiting
# =======================
# Enable rate limiting for production
RATE_LIMITER_ENABLED=true

# Comma-separated list of trusted IP addresses (leave empty to allow all for docker)
ADMIN_ALLOWED_IPS=

# =======================
# Optional: Local MongoDB Configuration
# =======================
# Only if using local MongoDB in docker-compose
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASSWORD=your-mongo-password
